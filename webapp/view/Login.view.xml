<mvc:View
    controllerName="br.com.smartpcm.rastreamento.zrastreio.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page
        showHeader="false"
        backgroundDesign="Transparent"
        class="loginBackground">

        <content>

            <VBox   
                width="100%"
                height="100%"
                justifyContent="Center"
                alignItems="Center"
                backgroundDesign="Transparent">
            
                <!-- ALTERADO: width aumentado de 500px     para 600px -->
                <Panel
                    width="420px"
                    accessibleRole="Form"
                    backgroundDesign="Solid"
                    class="sapUiResponsivePadding fonteCustomizada">

                    <content>
                        <!-- Cabeçalho do Formulário Centrado com margens reduzidas -->
                        <VBox
                            alignItems="Center"
                            class="sapUiSmallMarginBottom sapUiSmallMarginTop">

                            <Title
                                text="Rastreamento de componentes"
                                level="H2"
                                class="sapUiSmallMarginTop tituloLogin" />

                            <Text
                                text="COORD MAN DIGITAL GEST ATIVOS"
                                class="sapUiTinyMarginTop subtituloLogin" />
                            <Text
                                text=""
                                class="sapUiTinyMarginTop subtituloLogin" />
                            <Text
                                text=""
                                class="sapUiTinyMarginTop subtituloLogin" />


                        </VBox>

                        <!-- Campo Usuário -->
                        <Label
                            text="Usuário"
                            required="true"
                            class="sapUiTinyMarginBottom labelLogin" />

                        <Input
                            id="idUsuario"
                            maxLength="8"
                            placeholder="Digite sua matrícula"
                            class="sapUiSmallMarginBottom inputLogin" />

                        <!-- Campo Senha -->
                        <Label
                            text="Senha"
                            required="true"
                            class="sapUiTinyMarginBosttom slabelLogin" />

                        <Input
                            id="idSenha"
                            type="Password"
                            placeholder="Digite sua senha"
                            class="inputLogin" />

                        <!-- BOTÃO ENTRAR REPOSICIONADO com margens reduzidas -->

                        <VBox
                            width="100%"
                            alignItems="Stretch"
                            class="sapUiSmallMarginTop sapUiTinyMarginBottom">
                            <Text
                                text=""
                                class="sapUiTinyMarginTop subtituloLogin" />
                            <Text
                                text=""
                                class="sapUiTinyMarginTop subtituloLogin" />

                            <Button
                                text="Entrar"
                                width="100%"
                                type="Emphasized"
                                class="loginButton"
                                press="onEntrarPress" />
                        </VBox>


                    </content>


                </Panel>

            </VBox>

        </content>

    </Page>

</mvc:View>